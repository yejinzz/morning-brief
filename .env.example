# Morning Brief — 환경 변수 예시 (값은 비워둠. 실제 값은 절대 커밋 금지)
# 자세한 비밀키 정책: docs/SECRETS.md
# ※ Supabase 신규 API 키 체계: publishable(=구 anon) / secret(=구 service_role)

# ── 서버(배치) 전용 · GitHub Actions Secret 에만 저장 · 브라우저 미노출 ──
SUPABASE_URL=
SUPABASE_SECRET_KEY=            # sb_secret_... (RLS 우회, 쓰기)
GEMINI_API_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com
# (선택) 공공데이터포털 정책뉴스 API
DATA_GO_KR_KEY=

# ── 클라이언트(PWA) 빌드 변수 · 공개 가능(RLS 전제) ──
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=   # sb_publishable_... (RLS 적용, 읽기)
VITE_VAPID_PUBLIC_KEY=
# GitHub Pages 서브경로(프로젝트 사이트). 배포 워크플로가 설정.
VITE_BASE=/morning-brief/

# ── 파이프라인 동작 설정 ──
# 저장/푸시: SUPABASE_URL+SECRET, VAPID 가 있으면 live, 없으면 인메모리/Mock.
# AI: mock(기본, 무료·비용0) | gemini(실분석)
MB_AI=mock
# AI 일일 상한(요청/토큰/실패)
MB_AI_MAX_REQUESTS_PER_DAY=300
MB_AI_MAX_TOKENS_PER_DAY=500000
MB_AI_MAX_FAILURES=20
