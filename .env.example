# Morning Brief — 환경 변수 예시 (값은 비워둠. 실제 값은 절대 커밋 금지)
# 자세한 비밀키 정책: docs/SECRETS.md

# ── 서버(배치) 전용 · GitHub Actions Secret 에만 저장 · 브라우저 미노출 ──
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
GEMINI_API_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com
# (선택) 공공데이터포털 정책뉴스 API
DATA_GO_KR_KEY=

# ── 클라이언트(PWA) 빌드 변수 · 공개 가능(RLS 전제) ──
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
VITE_VAPID_PUBLIC_KEY=

# ── 파이프라인 동작 설정 ──
# 로컬 Mock 모드: 외부 호출 없이 fixtures 로 동작
MB_MODE=mock
# AI 일일 상한(요청/토큰/실패)
MB_AI_MAX_REQUESTS_PER_DAY=300
MB_AI_MAX_TOKENS_PER_DAY=500000
MB_AI_MAX_FAILURES=20
